{
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(npx prettier:*)",
      "Bash(npm *)",
      "mcp__playwright__*",
      "mcp__claude-in-chrome__*",
      "Bash(npx supabase:*)",
      "Bash(npx turbo:*)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(docker *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ],
    "ask": ["Bash(git push:*)"]
  },
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowLocalBinding": true
    }
  }
}
