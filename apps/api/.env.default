# Copy to .env.development.local and fill in. Values here are placeholders —
# never commit real secrets to this file.
NODE_ENV=development
APP_ENV=

# Supabase Auth issues the JWTs this api verifies via JWKS.
# Locally: AUTH_DOMAIN=http://127.0.0.1:54341/auth/v1  AUTH_AUDIENCE=authenticated
AUTH_AUDIENCE=
AUTH_DOMAIN=

# Storage signed URLs only — never used for data access.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Direct Postgres connection (the `postgres` library, not the Supabase SDK).
DB_HOSTNAME=db
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Shared secret for service-to-service calls (middleware/internal-service-auth.ts).
INTERNAL_SERVICE_AUTH_KEY=

# Cloud Scheduler OIDC verification (middleware/google-oidc-auth.ts).
CLOUD_SCHEDULER_OIDC_AUDIENCE=
CLOUD_SCHEDULER_OIDC_SERVICE_ACCOUNT=

# --- Mastra module. Remove this block if you don't use Mastra. ---
# Workflow state lives in the same Postgres instance, in a `mastra` schema.
MASTRA_DB_HOSTNAME=
MASTRA_DB_PORT=
MASTRA_DB_NAME=
MASTRA_DB_USERNAME=
MASTRA_DB_PASSWORD=
MASTRA_API_KEY=
OPENAI_API_KEY=
