{
  "name": "@repo/webapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3002",
    "build": "tsr generate && tsc -b && vite build",
    "build:staging": "tsr generate && tsc -b && vite build --mode staging",
    "preview": "vite preview",
    "lint": "tsr generate && tsc -b && eslint \"src/**/*.ts*\" --fix --max-warnings 0",
    "deploy:staging": "npm run build:staging && firebase deploy --only hosting:staging",
    "deploy:production": "npm run build && firebase deploy --only hosting:production"
  },
  "volta": {
    "extends": "../../package.json"
  },
  "dependencies": {
    "@repo/api-types": "*",
    "@repo/ui": "*",
    "@marsidev/react-turnstile": "1.6.0",
    "@supabase/supabase-js": "2.112.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.30",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/router-cli": "1.167.31",
    "@tanstack/router-plugin": "1.168.33",
    "@types/node": "24.13.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}
