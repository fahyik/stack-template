{
  "name": "stack-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "init": "node scripts/init.ts",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "clean:all": "find . \\( -type d \\( -name '.next' -o -name '.turbo' -o -name 'node_modules' \\) -o -name '*.tsbuildinfo' \\) -exec rm -rf '{}' \\+",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-deps": "npm-check-updates --workspaces --interactive"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "npm-check-updates": "23.0.2",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.10.11"
  },
  "overrides": {
    "uuid": "14.0.0",
    "zod": "4.4.3",
    "esbuild": "0.28.1",
    "lodash": "4.18.1"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0",
    "npm": ">=11.17.0"
  },
  "volta": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.4": true,
    "unrs-resolver@1.12.2": true
  }
}
