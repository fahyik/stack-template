{
  "name": "@repo/logger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc -w",
    "lint": "eslint \"src/**/*.ts*\" --fix --max-warnings 0",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "jest": {
    "preset": "@repo/jest-presets/node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  },
  "volta": {
    "extends": "../../package.json"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/morgan": "1.9.10",
    "@types/node": "24.13.2",
    "@repo/eslint-config": "*",
    "@repo/jest-presets": "*",
    "@repo/typescript-config": "*",
    "eslint": "10.8.1",
    "jest": "30.4.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "logform": "2.7.0",
    "morgan": "1.11.0",
    "uuid": "14.0.2",
    "winston": "3.19.0"
  }
}
