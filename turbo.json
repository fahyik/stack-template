{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["npm_package_name", "npm_package_version"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "dependsOn": ["^build"],
      "env": [
        "NODE_ENV",
        "APP_ENV",
        "CLUSTER_ENVIRONMENT",
        "LOCAL_LOG_DUMP",
        "PACKAGE_NAME",
        "PACKAGE_VERSION",
        "PORT",
        "DB_HOSTNAME",
        "DB_PORT",
        "DB_NAME",
        "DB_USERNAME",
        "DB_PASSWORD",
        "AUTH_AUDIENCE",
        "AUTH_DOMAIN",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "INTERNAL_SERVICE_AUTH_KEY",
        "CLOUD_SCHEDULER_OIDC_AUDIENCE",
        "CLOUD_SCHEDULER_OIDC_SERVICE_ACCOUNT",
        "MASTRA_DB_HOSTNAME",
        "MASTRA_DB_PORT",
        "MASTRA_DB_NAME",
        "MASTRA_DB_USERNAME",
        "MASTRA_DB_PASSWORD",
        "MASTRA_API_KEY",
        "OPENAI_API_KEY",
        "VITE_API_URL",
        "VITE_SUPABASE_URL",
        "VITE_SUPABASE_ANON_KEY",
        "VITE_TURNSTILE_SITE_KEY"
      ]
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
